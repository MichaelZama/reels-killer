{
  "version": 1,
  "apps": [
    {
      "id": "instagram",
      "packages": ["com.instagram.android"],
      "label": "You are in Instagram Reels.",
      "exitAction": "back",
      "rules": [
        {
          "name": "reels_tab",
          "mode": "feed",
          "allOf": [
            { "viewId": "clips_viewer_view_pager" },
            { "viewId": "clips_tab", "selected": true }
          ]
        },
        {
          "name": "single_reel",
          "mode": "single",
          "pagerViewId": "clips_viewer_view_pager",
          "allOf": [ { "viewId": "clips_viewer_view_pager" } ]
        }
      ]
    },
    {
      "id": "youtube",
      "packages": ["com.google.android.youtube"],
      "label": "You are in YouTube Shorts.",
      "exitAction": "back",
      "rules": [
        {
          "name": "shorts_tab",
          "mode": "feed",
          "anyOf": [
            { "viewId": "reel_recycler" },
            { "viewId": "reel_watch_fragment_root" }
          ],
          "allOf": [ { "descAnyOf": ["Shorts"], "selected": true } ]
        },
        {
          "name": "single_short",
          "mode": "single",
          "pagerViewId": "reel_recycler",
          "anyOf": [
            { "viewId": "reel_recycler" },
            { "viewId": "reel_watch_fragment_root" }
          ]
        }
      ]
    },
    {
      "id": "tiktok",
      "packages": ["com.zhiliaoapp.musically", "com.ss.android.ugc.trill"],
      "label": "You are on TikTok.",
      "exitAction": "home",
      "rules": [ { "name": "whole_app", "mode": "feed", "always": true } ]
    },
    {
      "id": "facebook",
      "packages": ["com.facebook.katana"],
      "label": "You are in Facebook Reels.",
      "exitAction": "back",
      "rules": [
        {
          "name": "reels_tab",
          "mode": "feed",
          "allOf": [
            { "descAnyOf": ["Reels", "Reel"], "selected": true },
            { "scrollable": true, "minHeightFraction": 0.8 }
          ]
        }
      ]
    }
  ]
}
