    <!-- Servizio di accessibilità -->
    <string name="service_label">Blocca-Reels</string>
    <string name="service_summary">Interrompe Reels, Shorts e TikTok con una schermata di pausa.</string>
    <string name="service_description">Blocca-Reels legge la struttura della schermata per accorgersi quando sei nei video brevi (Reels di Instagram, Shorts di YouTube, TikTok, Reels di Facebook) e mostra una schermata di pausa. Non legge i tuoi messaggi, non salva nulla e non ha accesso a internet.</string>

    <!-- Messaggi di default della schermata di blocco (sezione 4.6) -->
    <string-array name="default_messages">
        <item>Era quello che volevi fare?</item>
        <item>Ancora qui. Ti serve davvero?</item>
        <item>Cosa stavi cercando quando hai aperto l\'app?</item>
        <item>Un respiro. Poi decidi tu.</item>
        <item>Tra dieci minuti sarai contento di essere rimasto?</item>
        <item>C\'è qualcosa di meglio da fare adesso?</item>
    </string-array>

