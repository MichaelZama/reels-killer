    <!-- Accessibility service -->
    <string name="service_summary">Interrupts Reels, Shorts and TikTok with a pause screen.</string>
    <string name="service_description">Reels Killer reads the structure of the screen to notice when you are in short videos (Instagram Reels, YouTube Shorts, TikTok, Facebook Reels) and shows a pause screen. It does not read your messages, saves nothing and has no internet access.</string>

    <!-- Default block screen messages -->
    <string-array name="default_messages">
        <item>Is this what you wanted to do?</item>
        <item>Still here. Do you really need this?</item>
        <item>What were you looking for when you opened the app?</item>
        <item>Take a breath. Then you decide.</item>
        <item>Ten minutes from now, will you be glad you stayed?</item>
        <item>Is there something better to do right now?</item>
    </string-array>

