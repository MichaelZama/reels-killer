<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfondo"
    android:clickable="true"
    android:focusable="false"
    android:soundEffectsEnabled="false">

    <ScrollView
        android:id="@+id/overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/overlay_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/overlay_illustration"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/bg_illustration"
                android:importantForAccessibility="no"
                android:padding="28dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/ill_tramonto" />

            <FrameLayout
                android:id="@+id/overlay_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_media"
                android:minHeight="120dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/overlay_media_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxHeight="320dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextureView
                    android:id="@+id/overlay_media_video"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/testo"
                android:textSize="22sp"
                tools:text="Era quello che volevi fare?" />

            <TextView
                android:id="@+id/overlay_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:textColor="@color/testo_secondario"
                android:textSize="15sp"
                tools:text="Sei nei Reels di Instagram." />

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/overlay_exit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_exit_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/overlay_exit"
                android:textColor="@color/su_accento"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/overlay_continue"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_text_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="160dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <app.bloccareels.overlay.RingView
                    android:id="@+id/overlay_ring"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/overlay_continue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/overlay_continue"
                    android:textColor="@color/testo_secondario"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/overlay_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:textColor="@color/testo_secondario"
                android:textSize="13sp"
                tools:text="3ª volta oggi" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
